# Copy to .env.local for local development (vercel dev). Set the same names in Vercel project settings.
# Never commit real keys.

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Google Maps browser key. Enable Maps JavaScript API and Directions API.
# Restrict by HTTP referrer to your production domain and by API.
GOOGLE_MAPS_KEY=

# Comma separated list of origins allowed to call /api/*. Use your custom domain, for example:
# https://www.example.org,https://example.org
ALLOWED_ORIGIN=
